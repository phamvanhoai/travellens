NODE_ENV=development
PORT=3000

# PostgreSQL database config
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=travel360
# DB_USER=postgres
# DB_PASSWORD=your_db_password

# Supabase PostgreSQL pooler config
DB_HOST=your_supabase_host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=true
# PostgreSQL TIMESTAMP values are stored as Vietnam local time.
DB_TIMEZONE_OFFSET=+07:00
# Keep this low for serverless deployments using a session-mode pooler.
DB_POOL_MAX=1
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=10000
DB_MAX_USES=500

# Optional: use this instead of DB_* variables when deployed
DATABASE_URL=

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=

# Email notification config
APP_NAME=TravelLens
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional. One or many refund staff emails, separated by comma. If empty, active staff/admin emails are used.
REFUND_NOTIFY_EMAILS=

# Zalo Bot config
ZALO_BOT_TOKEN=
ZALO_BOT_WEBHOOK_SECRET_TOKEN=
# One or many chat IDs, separated by comma. Send /chatid to the bot after webhook is configured to get a chat ID.
ZALO_PAYMENT_NOTIFY_CHAT_IDS=
ZALO_BOOKING_NOTIFY_CHAT_IDS=

# Weather API config (Open-Meteo, no API key required)
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_API_TIMEOUT_MS=5000

# Object Storage config (S3-compatible, CloudFly)
OBJECT_STORAGE_ENDPOINT=https://s3.cloudfly.vn
OBJECT_STORAGE_REGION=hn
OBJECT_STORAGE_BUCKET=travellens
OBJECT_STORAGE_ACCESS_KEY_ID=your_object_storage_access_key
OBJECT_STORAGE_SECRET_ACCESS_KEY=your_object_storage_secret_key
# Optional. Set if your provider has a custom public CDN/domain.
OBJECT_STORAGE_PUBLIC_BASE_URL=

# SePay payment config
SEPAY_WEBHOOK_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=
PAYMENT_CODE_PREFIX=TVL
PAYMENT_EXPIRE_MINUTES=15
# Minimum amount supported by the bank transfer QR flow. Use 0 only for free bookings.
BANK_TRANSFER_MIN_AMOUNT=2000
# Manual confirmations hold capacity for 24 hours. API traffic runs expiry sweeps every 30 seconds.
MANUAL_CONFIRMATION_EXPIRE_MINUTES=1440
UNPAID_BOOKING_EXPIRE_MINUTES=1440
EXPIRY_SWEEP_INTERVAL_MS=30000
